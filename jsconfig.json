{
  "compilerOptions": {
    "skipLibCheck": true,
    "checkJs": false,
    "types": [],
    "paths": {
      // Folders
      "@/components/*": ["./src/components/*"],
      "@/contexts/*": ["./src/contexts/*"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/layouts/*": ["./src/layouts/*"],
      "@/mocks/*": ["./src/mocks/*"],
      "@/pages/*": ["./src/pages/*"],
      "@/redux/*": ["./src/redux/*"],
      "@/theme/*": ["./src/theme/*"],
      "@/services/*": ["./src/services/*"],
      "@/utils/*": ["./src/utils/*"],
      "@/vendor/*": ["./src/vendor/*"],

      // Files
      "@/constants": ["./src/constants"],
      "@/config": ["./src/config"],
      "@/i18n": ["./src/i18n"],
      "@/mocks": ["./src/mocks/index"],
      "@/theme": ["./src/theme/index"]
    }
  },
  "exclude": ["node_modules", "dist", "build"]
}
